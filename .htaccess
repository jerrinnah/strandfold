# Strandfold — server rules.
Options -Indexes

# The content store, templates and CLI are application internals. Nothing here
# should ever be fetched over HTTP; content/ in particular holds password
# hashes in users.json.
RedirectMatch 404 ^/(content|templates|cli|src|tools)(/|$)
RedirectMatch 404 ^/admin/(lib|views)(/|$)
RedirectMatch 404 /\.(git|env|htaccess|cpanel\.yml)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer"
  # No third-party requests are made by this site. Locking that down means a
  # future edit cannot quietly add an analytics tag or a chat widget that would
  # expose who is reading a domestic-abuse site.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# Clean URLs: /get-help rather than /get-help.html
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send /index.html and /page.html to the clean form, once, permanently.
  # Anything already linking to the old URLs keeps working.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Drop a trailing slash, so /get-help/ does not break relative paths.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve the file behind the clean URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# MultiViews would guess at extensions itself and fight the rules above.
Options -MultiViews

ErrorDocument 404 /index.html
